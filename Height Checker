import java.util.Arrays;

class Solution {
    public int heightChecker(int[] heights) {
        int[] expected = heights.clone();
        Arrays.sort(expected);
        int count = 0;
        for (int i = 0; i < heights.length; i++) {
            if (heights[i] != expected[i]) {
                count++;
            }
        }
        return count;
    }

    public static void main(String[] args) {
        Solution sol = new Solution();
        System.out.println(sol.heightChecker(new int[]{1, 1, 4, 2, 1, 3})); // Output: 3
        System.out.println(sol.heightChecker(new int[]{5, 1, 2, 3, 4}));    // Output: 5
        System.out.println(sol.heightChecker(new int[]{1, 2, 3, 4, 5}));    // Output: 0
    }
}
