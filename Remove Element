import java.util.Arrays;

class Solution {
    public int removeElement(int[] nums, int val) {
        int k = 0;
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != val) {
                nums[k] = nums[i];
                k++;
            }
        }
        return k;
    }

    public static void main(String[] args) {
        Solution sol = new Solution();

        int[] a = {3, 2, 2, 3};
        int ka = sol.removeElement(a, 3);
        System.out.println("k = " + ka + ", kept prefix = " + Arrays.toString(Arrays.copyOf(a, ka))); // k = 2, [2, 2]

        int[] b = {0, 1, 2, 2, 3, 0, 4, 2};
        int kb = sol.removeElement(b, 2);
        System.out.println("k = " + kb + ", kept prefix = " + Arrays.toString(Arrays.copyOf(b, kb))); // k = 5, [0, 1, 3, 0, 4]
    }
}
