class Solution {
    public double average(int[] salary) {
        double sum = 0;
        int min = salary[0], max = salary[0];
        for (int s : salary) {
            sum += s;
            if (s < min) min = s;
            if (s > max) max = s;
        }
        return (sum - min - max) / (salary.length - 2);
    }
}
