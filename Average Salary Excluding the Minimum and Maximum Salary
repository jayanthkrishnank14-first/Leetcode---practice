class Solution {
    public double average(int[] salary) {
        double sum = 0;
        int min = salary[0], max = salary[0];
        for (int s : salary) {
            sum += s;
            if (s < min) min = s;
            if (s > max) max = s;
        }
        return (sum - min - max) / (salary.length - 2);
    }

    public static void main(String[] args) {
        Solution sol = new Solution();
        System.out.println(sol.average(new int[]{4000, 3000, 1000, 2000})); // Output: 2500.0
        System.out.println(sol.average(new int[]{1000, 2000, 3000}));       // Output: 2000.0
    }
}
