import java.util.Arrays;

class Solution {
    public int findContentChildren(int[] g, int[] s) {
        Arrays.sort(g);
        Arrays.sort(s);
        int i = 0, j = 0;
        while (i < g.length && j < s.length) {
            if (s[j] >= g[i]) {
                i++;
            }
            j++;
        }
        return i;
    }

    public static void main(String[] args) {
        Solution sol = new Solution();
        System.out.println(sol.findContentChildren(new int[]{1, 2, 3}, new int[]{1, 1})); // Output: 1
        System.out.println(sol.findContentChildren(new int[]{1, 2}, new int[]{1, 2, 3})); // Output: 2
    }
}
