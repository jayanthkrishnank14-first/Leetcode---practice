class Solution {
    public int pivotIndex(int[] nums) {
        int totalSum = 0, leftSum = 0;
        for (int num : nums) totalSum += num;
        for (int i = 0; i < nums.length; i++) {
            if (leftSum == totalSum - leftSum - nums[i]) {
                return i;
            }
            leftSum += nums[i];
        }
        return -1;
    }

    public static void main(String[] args) {
        Solution sol = new Solution();
        System.out.println(sol.pivotIndex(new int[]{1, 7, 3, 6, 5, 6})); // Output: 3
        System.out.println(sol.pivotIndex(new int[]{1, 2, 3}));          // Output: -1
        System.out.println(sol.pivotIndex(new int[]{2, 1, -1}));         // Output: 0
    }
}
