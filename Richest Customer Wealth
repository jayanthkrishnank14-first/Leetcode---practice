class Solution {
    public int maximumWealth(int[][] accounts) {
        int maxWealth = 0;
        for (int[] customer : accounts) {
            int currentWealth = 0;
            for (int bank : customer) {
                currentWealth += bank;
            }
            maxWealth = Math.max(maxWealth, currentWealth);
        }
        return maxWealth;
    }

    public static void main(String[] args) {
        Solution sol = new Solution();
        System.out.println(sol.maximumWealth(new int[][]{{1, 2, 3}, {3, 2, 1}}));       // Output: 6
        System.out.println(sol.maximumWealth(new int[][]{{1, 5}, {7, 3}, {3, 5}}));     // Output: 10
        System.out.println(sol.maximumWealth(new int[][]{{2, 8, 7}, {7, 1, 3}, {1, 9, 5}})); // Output: 17
    }
}
