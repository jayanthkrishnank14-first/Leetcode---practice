import java.util.*;

class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        int max = 0;
        for (int c : candies) {
            if (c > max) max = c;
        }
        List<Boolean> result = new ArrayList<>();
        for (int c : candies) {
            result.add(c + extraCandies >= max);
        }
        return result;
    }

    public static void main(String[] args) {
        Solution sol = new Solution();
        System.out.println(sol.kidsWithCandies(new int[]{2, 3, 5, 1, 3}, 3)); // Output: [true, true, true, false, true]
        System.out.println(sol.kidsWithCandies(new int[]{4, 2, 1, 1, 2}, 1)); // Output: [true, false, false, false, false]
        System.out.println(sol.kidsWithCandies(new int[]{12, 1, 12}, 10));     // Output: [true, false, true]
    }
}
